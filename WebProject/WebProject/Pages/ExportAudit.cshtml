@page
@model WebProject.Pages.ExportAuditModel

@{
    ViewData["Title"] = "Export Audit Trail";
}

<div class="container mt-4">

    <h1>Export Audit Trail</h1>

    <p class="text-muted">
        Generate a PDF containing audit records
        for a selected timeframe.
    </p>

    <hr />

    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h4 class="mb-4">Export Options</h4>

                    <form method="post">

                        <div asp-validation-summary="All"
                             class="text-danger mb-3"></div>

                        <div class="form-check mb-3">
                            <input asp-for="Input.ExportType"
                                   type="radio"
                                   value="All"
                                   id="allTime"
                                   class="form-check-input" />

                            <label for="allTime"
                                   class="form-check-label">
                                All Time
                            </label>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="Input.ExportType"
                                   type="radio"
                                   value="Custom"
                                   id="customRange"
                                   class="form-check-input" />

                            <label for="customRange"
                                   class="form-check-label">
                                Custom Date Range
                            </label>
                        </div>

                        <div id="dateRangeFields" class="mb-4">

                            <div class="mb-3">
                                <label asp-for="Input.StartDate"
                                       class="form-label">
                                    Start Date
                                </label>

                                <input asp-for="Input.StartDate"
                                       type="date"
                                       class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.EndDate"
                                       class="form-label">
                                    End Date
                                </label>

                                <input asp-for="Input.EndDate"
                                       type="date"
                                       class="form-control" />
                            </div>

                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Generate PDF
                        </button>

                        <a asp-page="/Dashboard"
                           class="btn btn-secondary w-100 mt-2">
                            Back to Dashboard
                        </a>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateDateFields() {
            const custom = document.getElementById(
                "customRange").checked;

            document.getElementById(
                "dateRangeFields").style.display =
                custom ? "block" : "none";
        }

        document.querySelectorAll(
            'input[name="Input.ExportType"]'
        ).forEach(radio => {
            radio.addEventListener(
                "change", updateDateFields);
        });

        updateDateFields();
    </script>
}
