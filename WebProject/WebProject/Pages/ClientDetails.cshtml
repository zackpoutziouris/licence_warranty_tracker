@page
@model WebProject.Pages.ClientDetailsModel

@{
    ViewData["Title"] = "Client Details";
}

<div class="container mt-4 mb-5">

    <!-- Client Header -->
    <div class="d-flex flex-wrap justify-content-between
        align-items-center gap-3 mb-4">

        <div>
            <h1 class="mb-1">@Model.Client.ClientName</h1>
            <p class="text-muted mb-0">
                Client ID: @Model.Client.ClientId
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-page="/EditClient"
               asp-route-id="@Model.Client.ClientId"
               class="btn btn-outline-primary">
                Edit Client
            </a>

            <a asp-page="/Clients"
               class="btn btn-secondary">
                Back to Clients
            </a>
        </div>

    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mb-4">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Assigned Staff -->
    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">

            <h3 class="h5 mb-3">Assigned Staff</h3>

            @if (!Model.Client.ClientStaff.Any())
            {
                <p class="text-muted mb-0">
                    No staff members assigned.
                </p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var assignment in Model.Client.ClientStaff)
                    {
                        <li class="list-group-item d-flex
                            justify-content-between
                            align-items-center">

                            <span>
                                @assignment.Staff.StaffEmail
                            </span>

                            @if (assignment.Staff.IsAdmin)
                            {
                                <span class="badge bg-secondary">
                                    Admin
                                </span>
                            }

                        </li>
                    }
                </ul>
            }

        </div>
    </div>

    <!-- Warranties -->
    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">

            <div class="d-flex flex-wrap
                justify-content-between
                align-items-center gap-2 mb-3">

                <h3 class="h5 mb-0">Warranties</h3>

                <a asp-page="/AddWarranty"
                   asp-route-clientId="@Model.Client.ClientId"
                   class="btn btn-primary btn-sm">
                    Add Warranty
                </a>

            </div>

            @if (!Model.Client.Warranties.Any())
            {
                <p class="text-muted mb-0">
                    No warranties added.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped
                        table-hover align-middle mb-0">

                        <thead>
                            <tr>
                                <th>Warranty ID</th>
                                <th>Asset Name</th>
                                <th>Warranty Expiry Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var warranty in Model.Client.Warranties)
                            {
                                <tr>
                                    <td>@warranty.WarrantyId</td>
                                    <td>@warranty.AssetName</td>
                                    <td>
                                        @warranty.ExpiryDate
                                    </td>
                                    <td class="text-end">
                                        <a asp-page="/EditWarranty"
                                           asp-route-id="@warranty.WarrantyId"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

    <!-- Licences -->
    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">

            <div class="d-flex flex-wrap
                justify-content-between
                align-items-center gap-2 mb-3">

                <h3 class="h5 mb-0">Licences</h3>

                <a asp-page="/AddLicense"
                   asp-route-clientId="@Model.Client.ClientId"
                   class="btn btn-primary btn-sm">
                    Add Licence
                </a>

            </div>

            @if (!Model.Client.Licenses.Any())
            {
                <p class="text-muted mb-0">
                    No licences added.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped
                        table-hover align-middle mb-0">

                        <thead>
                            <tr>
                                <th>Licence ID</th>
                                <th>Licence Name</th>
                                <th>License Expiry Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var license in Model.Client.Licenses)
                            {
                                <tr>
                                    <td>@license.LicenseId</td>
                                    <td>@license.LicenseName</td>
                                    <td>
                                        @license.ExpiryDate
                                    </td>
                                    <td class="text-end">
                                        <a asp-page="/EditLicense"
                                           asp-route-id="@license.LicenseId"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>
