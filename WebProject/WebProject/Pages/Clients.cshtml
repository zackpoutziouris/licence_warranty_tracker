@page
@model WebProject.Pages.ClientsModel

@{
    ViewData["Title"] = "Manage Clients";
}

<div class="container mt-4">

    <h1>Manage Clients</h1>

    <p class="text-muted">
        View and manage client organisations.
    </p>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mb-3">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="d-flex gap-2 mb-3">
        <a asp-page="/CreateClient"
           class="btn btn-primary">
            Create New Client
        </a>

        <a asp-page="/Dashboard"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (Model.Clients.Count == 0)
    {
        <div class="alert alert-info">
            No clients have been added yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">

                <thead>
                    <tr>
                        <th>Client ID</th>
                        <th>Client Name</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var client in Model.Clients)
                    {
                        <tr>
                            <td>@client.ClientId</td>
                            <td>@client.ClientName</td>

                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">

                                    <!-- View Client -->
                                    <a asp-page="/ClientDetails"
                                       asp-route-id="@client.ClientId"
                                       class="btn btn-sm btn-primary">
                                        View Details
                                    </a>

                                    <!-- Delete Client -->
                                    <a asp-page="/DeleteClient"
                                       asp-route-id="@client.ClientId"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>
