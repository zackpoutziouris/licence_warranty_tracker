@page
@model WebProject.Pages.DashboardModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">

    <h1>Asset Tracker Dashboard</h1>

    <p>Welcome, @User.Identity?.Name!</p>

    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <h3>Welcome to the Asset & Licence Tracker</h3>

    <p>
        From here you will be able to manage client assets,
        software licences and expiry dates.
    </p>

    @if (User.IsInRole("Admin"))
    {
        <div class="mt-3 d-flex gap-2">

            <a asp-page="/CreateAccount"
               class="btn btn-primary">
                Create Staff Account
            </a>

            <a asp-page="/StaffAccounts"
               class="btn btn-secondary">
                View / Update Staff Accounts
            </a>

            <a asp-page="/ExportAudit"
               class="btn btn-outline-primary">
                Export Audit Trail
            </a>
        </div>
    }
    else
    {
        <div class="mt-3">

            <a asp-page="/MyAccount"
               class="btn btn-primary">
                My Account
            </a>

        </div>
    }

</div>
