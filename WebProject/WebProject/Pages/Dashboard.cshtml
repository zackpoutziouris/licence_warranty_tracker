@page
@model WebProject.Pages.DashboardModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4 mb-5">

    <h1>Asset Tracker Dashboard</h1>

    <p>Welcome, @User.Identity?.Name!</p>

    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <h3>Welcome to the Asset & Licence Tracker</h3>

    <p>
        From here you will be able to manage client assets,
        software licences and expiry dates.
    </p>

    @if (User.IsInRole("Admin"))
    {
        <!-- Existing Admin Buttons -->
        <div class="mt-3 d-flex flex-wrap gap-2">

            <a asp-page="/CreateAccount"
               class="btn btn-primary">
                Create Staff Account
            </a>

            <a asp-page="/StaffAccounts"
               class="btn btn-secondary">
                View / Update Staff Accounts
            </a>

            <a asp-page="/ExportAudit"
               class="btn btn-outline-primary">
                Export Audit Trail
            </a>

            <a asp-page="/Clients"
               class="btn btn-primary">
                Manage Clients
            </a>

        </div>

    }
    else
    {
        <div class="mt-3 d-flex flex-wrap gap-2">
            <a asp-page="/MyAccount" class="btn btn-primary">My Account</a>
            <a asp-page="/Clients" class="btn btn-primary">Manage Clients</a>
        </div>
    }

    <!-- Notifications button for both Admin and Staff -->
    <div class="mt-3">
        <button type="button"
                class="btn @(Model.NotificationCount > 0 ? "btn-danger notification-glow" : "btn-outline-secondary")"
                data-bs-toggle="modal"
                data-bs-target="#notificationModal">
            Notifications
            @if (Model.NotificationCount > 0)
            {
                <span class="badge bg-light text-danger ms-1">
                    @Model.NotificationCount
                </span>
            }
        </button>
    </div>

    <!-- Shared Client Overview -->
    <hr class="my-5" />

    <h2 class="mb-4">@(User.IsInRole("Admin") ? "Client & Expiry Overview" : "My Clients & Expiry Overview")</h2>

    <!-- Overall Totals -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="fs-2 fw-bold">
                        @Model.TotalClients
                    </div>
                    <div class="text-muted">
                        Total Clients
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="fs-2 fw-bold">
                        @Model.TotalWarranties.Total
                    </div>
                    <div class="text-muted">
                        Total Warranties
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="fs-2 fw-bold">
                        @Model.TotalLicenses.Total
                    </div>
                    <div class="text-muted">
                        Total Licences
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- All Warranties -->
    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">

            <h3 class="h5 mb-3">All Warranties</h3>

            <div class="row g-3">

                <div class="col-6 col-md-3">
                    <div class="border rounded p-3 text-center h-100">
                        <div class="fs-4 fw-bold">
                            @Model.TotalWarranties.Days30Plus
                        </div>
                        <small class="text-muted">
                            30+ Days
                        </small>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="border rounded p-3 text-center h-100">
                        <div class="fs-4 fw-bold">
                            @Model.TotalWarranties.Days7To29
                        </div>
                        <small class="text-muted">
                            7–29 Days
                        </small>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="border rounded p-3 text-center h-100">
                        <div class="fs-4 fw-bold text-warning">
                            @Model.TotalWarranties.Under7Days
                        </div>
                        <small class="text-muted">
                            Under 7 Days
                        </small>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="border rounded p-3 text-center h-100">
                        <div class="fs-4 fw-bold text-danger">
                            @Model.TotalWarranties.Expired
                        </div>
                        <small class="text-muted">
                            Expired
                        </small>
                    </div>
                </div>

            </div>

        </div>
    </div>

    <!-- All Licences -->
    <div class="card shadow-sm mb-5">
        <div class="card-body p-4">

            <h3 class="h5 mb-3">All Licences</h3>

            <div class="row g-3">

                <div class="col-6 col-md-3">
                    <div class="border rounded p-3 text-center h-100">
                        <div class="fs-4 fw-bold">
                            @Model.TotalLicenses.Days30Plus
                        </div>
                        <small class="text-muted">
                            30+ Days
                        </small>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="border rounded p-3 text-center h-100">
                        <div class="fs-4 fw-bold">
                            @Model.TotalLicenses.Days7To29
                        </div>
                        <small class="text-muted">
                            7–29 Days
                        </small>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="border rounded p-3 text-center h-100">
                        <div class="fs-4 fw-bold text-warning">
                            @Model.TotalLicenses.Under7Days
                        </div>
                        <small class="text-muted">
                            Under 7 Days
                        </small>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="border rounded p-3 text-center h-100">
                        <div class="fs-4 fw-bold text-danger">
                            @Model.TotalLicenses.Expired
                        </div>
                        <small class="text-muted">
                            Expired
                        </small>
                    </div>
                </div>

            </div>

        </div>
    </div>

    <!-- Individual Clients -->
    <div class="d-flex flex-wrap justify-content-between
        align-items-center gap-2 mb-3">

        <h2 class="h4 mb-0">@(User.IsInRole("Admin") ? "Client Overview" : "My Client Overview")</h2>

        <a asp-page="/Clients"
           class="btn btn-outline-primary">
            Manage Clients
        </a>

    </div>

    @if (!Model.ClientSummaries.Any())
    {
        <div class="alert alert-info">
            @(User.IsInRole("Admin") ? "No clients have been added yet." : "No clients are assigned to you yet.")
        </div>
    }
    else
    {
        @foreach (var client in Model.ClientSummaries)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-body p-4">

                    <div class="d-flex flex-wrap
                        justify-content-between
                        align-items-center gap-2 mb-3">

                        <div>
                            <h3 class="h5 mb-1">
                                @client.ClientName
                            </h3>

                            <span class="text-muted">
                                Client ID: @client.ClientId
                            </span>
                        </div>

                        <a asp-page="/ClientDetails"
                           asp-route-id="@client.ClientId"
                           class="btn btn-sm btn-primary">
                            View Details
                        </a>

                    </div>

                    <div class="row g-4">

                        <!-- Client Warranties -->
                        <div class="col-md-6">

                            <h4 class="h6 mb-3">
                                Warranties
                                (@client.Warranties.Total total)
                            </h4>

                            <div class="row g-2 text-center">

                                <div class="col-6">
                                    <div class="border rounded p-2">
                                        <strong>
                                            @client.Warranties.Days30Plus
                                        </strong>
                                        <div class="small text-muted">
                                            30+ Days
                                        </div>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="border rounded p-2">
                                        <strong>
                                            @client.Warranties.Days7To29
                                        </strong>
                                        <div class="small text-muted">
                                            7–29 Days
                                        </div>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="border rounded p-2">
                                        <strong class="text-warning">
                                            @client.Warranties.Under7Days
                                        </strong>
                                        <div class="small text-muted">
                                            Under 7 Days
                                        </div>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="border rounded p-2">
                                        <strong class="text-danger">
                                            @client.Warranties.Expired
                                        </strong>
                                        <div class="small text-muted">
                                            Expired
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- Client Licences -->
                        <div class="col-md-6">

                            <h4 class="h6 mb-3">
                                Licences
                                (@client.Licenses.Total total)
                            </h4>

                            <div class="row g-2 text-center">

                                <div class="col-6">
                                    <div class="border rounded p-2">
                                        <strong>
                                            @client.Licenses.Days30Plus
                                        </strong>
                                        <div class="small text-muted">
                                            30+ Days
                                        </div>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="border rounded p-2">
                                        <strong>
                                            @client.Licenses.Days7To29
                                        </strong>
                                        <div class="small text-muted">
                                            7–29 Days
                                        </div>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="border rounded p-2">
                                        <strong class="text-warning">
                                            @client.Licenses.Under7Days
                                        </strong>
                                        <div class="small text-muted">
                                            Under 7 Days
                                        </div>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="border rounded p-2">
                                        <strong class="text-danger">
                                            @client.Licenses.Expired
                                        </strong>
                                        <div class="small text-muted">
                                            Expired
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>

                </div>
            </div>
        }
    }

</div>

<!-- Notification Modal -->
<div class="modal fade"
     id="notificationModal"
     tabindex="-1"
     aria-labelledby="notificationModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="notificationModalLabel">
                    My Notifications (@Model.NotificationCount)
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (!Model.Notifications.Any())
                {
                    <div class="alert alert-info mb-0">
                        You have no new notifications.
                    </div>
                }
                else
                {
                    @foreach (var notification in Model.Notifications)
                    {
                        string borderClass = "border-secondary";
                        string textClass = "text-secondary";
                        string notificationTitle = "Notification";

                        if (notification.NotificationType.StartsWith("Overdue_"))
                        {
                            borderClass = "border-danger";
                            textClass = "text-danger";
                            notificationTitle = "Expired";
                        }
                        else if (notification.NotificationType == "Under7Days")
                        {
                            borderClass = "border-warning";
                            textClass = "text-warning";
                            notificationTitle = "Under 7 Days";
                        }
                        else if (notification.NotificationType == "Under30Days")
                        {
                            notificationTitle = "Under 30 Days";
                        }

                        <div class="card mb-3 @borderClass">
                            <div class="card-body">
                                <h6 class="fw-bold @textClass">
                                    @notificationTitle
                                </h6>
                                <p class="mb-2">@notification.Message</p>
                                <small class="text-muted">
                                    Generated:
                                    @(DateTime.TryParseExact(
                                        notification.NotificationDate,
                                        "yyyy-MM-dd",
                                        System.Globalization.CultureInfo.InvariantCulture,
                                        System.Globalization.DateTimeStyles.None,
                                        out var notificationDate)
                                        ? notificationDate.ToString("dd/MM/yyyy")
                                        : notification.NotificationDate)
                                </small>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>
