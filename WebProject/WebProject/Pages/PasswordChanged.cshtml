@page
@model WebProject.Pages.PasswordChangedModel

@{
    ViewData["Title"] = "Password Changed";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow">
                <div class="card-body p-5 text-center">

                    <h2 class="text-success mb-3">
                        Password Changed Successfully
                    </h2>

                    <p>
                        Your password has been updated successfully.
                    </p>

                    <p>
                        All existing login sessions have been
                        invalidated.
                    </p>

                    <p class="fw-bold">
                        You must log in again using your new password.
                    </p>

                    <p class="text-muted mt-4">
                        Redirecting to Login in <span id="countdown">10</span> seconds...
                    </p>

                    <a asp-page="/Login"
                       class="btn btn-primary mt-2">
                        Go to Login
                    </a>

                </div>
            </div>

        </div>
    </div>
</div>

<script>
    let secondsRemaining = 10;

    const countdown = document.getElementById("countdown");

    const timer = setInterval(function() {
        secondsRemaining--;

        countdown.textContent = secondsRemaining;

        if (secondsRemaining <= 0) {
            clearInterval(timer);
            window.location.replace('/Login');
        }
    }, 1000);
</script>
