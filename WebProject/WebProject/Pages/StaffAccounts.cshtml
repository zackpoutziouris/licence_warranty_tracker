@page
@model WebProject.Pages.StaffAccountsModel

@{
    ViewData["Title"] = "Manage Staff Accounts";
}

<div class="container mt-4">

    <h1>Manage Staff Accounts</h1>

    <p class="text-muted">
        View, edit and delete staff accounts.
    </p>

    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Staff ID</th>
                    <th>Email Address</th>
                    <th>Administrator</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var staff in Model.StaffAccounts)
                {
                    <tr>
                        <td>@staff.StaffId</td>

                        <td>@staff.StaffEmail</td>

                        <td>
                            @if (staff.IsAdmin)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </td>

                        <td>
                            <div class="d-flex gap-2">

                                <a asp-page="/EditStaff"
                                   asp-route-id="@staff.StaffId"
                                   class="btn btn-primary btn-sm">
                                    Edit
                                </a>

                                @if (staff.StaffId != Model.CurrentStaffId)
                                {
                                    <form method="post"
                                          asp-page-handler="Delete"
                                          asp-route-id="@staff.StaffId"
                                          onsubmit="return confirm('Are you sure you want to delete this staff account?');">

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            Delete
                                        </button>

                                    </form>
                                }

                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

    <a asp-page="/Dashboard" class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>

</div>
